class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        memo = {}

        def dfs(i, j):
            if (i, j) in memo:
                return memo[(i, j)]

            if i >= m or j >= n or i < 0 or j < 0:
                return 0

            if i == m - 1 and j == n - 1:
                return 1

            memo[(i, j)] = dfs(i + 1, j) + dfs(i, j + 1)
            
            return memo[(i, j)]
        
        return dfs(0,0)

############################################## Bottom Up ########################################

class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        
        if m == 1 and n == 1:
            return 1

        dp = [n * [1] for _ in range(m)]
        dp[0][0] = 0

        for i in range(1, m):
            for j in range(1, n):
                dp[i][j] = dp[i - 1][j] + dp[i][j - 1]
        return dp[m - 1][n - 1]
