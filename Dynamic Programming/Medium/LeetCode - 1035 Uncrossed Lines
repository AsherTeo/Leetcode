class Solution:
    def maxUncrossedLines(self, nums1: List[int], nums2: List[int]) -> int:
        memo = {}

        def dfs(i , j):
            if (i,j) in memo:
                return memo[(i,j)]
                
            if i < 0 or j < 0 or i >= len(nums1) or j >= len(nums2):
                return 0

            if nums1[i] == nums2[j]:
                return 1 + dfs(i + 1, j + 1)

            memo[(i,j)] = max(dfs(i + 1, j), dfs(i, j + 1))
            
            return memo[(i,j)] 
        return dfs(0,0)
