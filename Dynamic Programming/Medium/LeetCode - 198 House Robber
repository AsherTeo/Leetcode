class Solution:
    def rob(self, nums: List[int]) -> int:
        memo = {}

        def dfs(i):
            if i in memo:
                return memo[i]

            if i >= len(nums):
                return 0

            take = nums[i] + dfs(i + 2)
            skip = dfs(i + 1)
            memo[i] = max(take, skip)
            return memo[i] 

        return dfs(0)
