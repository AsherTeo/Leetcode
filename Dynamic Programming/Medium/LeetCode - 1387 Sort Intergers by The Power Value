class Solution:
    def getKth(self, lo: int, hi: int, k: int) -> int:

        memo = {}

        def dfs(node):
            
            if node in memo:
                return memo[node]

            total = 0

            if node == 1:
                return 0

            if node <= 0:
                return 0 

            if node % 2 == 0:
                new_node = node // 2
                total +=  1 + dfs(new_node)

            if node % 2:
                new_node = 3 * node + 1
                total += 1 + dfs(new_node)

            memo[node] = total 
            return memo[node]

        min_heap = []

        for i in range(lo, hi + 1):
            heapq.heappush(min_heap, (dfs(i), i))
        
        while k > 0:
            
            cost, node = heapq.heappop(min_heap)
            k-=1
            if k == 0:
                return node
