class Solution:
    def mostPoints(self, questions: List[List[int]]) -> int:
        memo = {}

        def dfs(i):
            if i in memo:
                return memo[i]

            if i >= len(questions):
                return 0

            take = questions[i][0] + dfs(i + questions[i][1] + 1)
            skip = dfs(i + 1)
            
            memo[i] = max(take, skip)
            return memo[i] 
